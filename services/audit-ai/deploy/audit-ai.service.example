[Unit]
Description=Audit Agent OCR and textual AI service
After=network.target

[Service]
Type=simple
User=admin
Group=admin
# Replace only this release path if the approved deployment root differs.
WorkingDirectory=/home/admin/audit_ai_runtime/current/services/audit-ai
EnvironmentFile=/home/admin/audit_ai_runtime/audit-ai.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/python/venvs/audit-ai/bin/python -m uvicorn audit_ai.main:app --app-dir /home/admin/audit_ai_runtime/current/services/audit-ai/src --host 127.0.0.1 --port 8001 --workers 1
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/admin/audit_ai_runtime

[Install]
WantedBy=multi-user.target
