# Safe configuration template. The explicit local profile starts without these variables.
AUDIT_DB_URL=
AUDIT_DB_USERNAME=
AUDIT_DB_PASSWORD=
AUDIT_REDIS_HOST=
AUDIT_REDIS_PORT=
AUDIT_REDIS_PASSWORD=
AUDIT_CACHE_KEY_PREFIX=audit-agent:
AUDIT_SESSION_REDIS_NAMESPACE=audit-agent:sessions
AUDIT_SESSION_TIMEOUT=30m
AUDIT_SESSION_COOKIE_SECURE=true
AUDIT_AI_BASE_URL=
AUDIT_AI_CONNECT_TIMEOUT_MS=5000
# Must exceed the 900s Contract Semantic provider-call budget; includes FastAPI overhead margin.
AUDIT_AI_READ_TIMEOUT_MS=960000
AUDIT_OCR_BASE_URL=
AUDIT_OCR_CONNECT_TIMEOUT_MS=5000
# OCR must wait for the isolated worker outcome; independent from model inference.
AUDIT_OCR_READ_TIMEOUT_MS=1900000
# Independent services/audit-ai runtime. Keep secrets empty in Git.
AUDIT_OCR_CPU_THREADS=1
AUDIT_OCR_ENABLE_MKLDNN=false
# Optional local offline models; leave blank to use bundled models when present.
AUDIT_OCR_FAST_ENABLED=true
AUDIT_OCR_FAST_MODEL_DIR=
AUDIT_AI_MAX_UPLOAD_BYTES=52428800
AUDIT_AI_TEMP_ROOT=
# Optional inventory marker; the current gateway consumes BASE_URL/API_KEY/NAME.
AUDIT_MODEL_PROVIDER=
AUDIT_MODEL_BASE_URL=
AUDIT_MODEL_API_KEY=
AUDIT_MODEL_NAME=
# Contract Semantic only. Keep PROMPT_ONLY until the exact provider/model passes
# the repository L1-L4 qualification; accepted values are PROMPT_ONLY,
# OPENAI_COMPAT_STRUCTURED, and OLLAMA_NATIVE_STRUCTURED.
AUDIT_SEMANTIC_STRUCTURED_TRANSPORT=PROMPT_ONLY
AUDIT_MODEL_CONNECT_TIMEOUT_SECONDS=5
# Global provider read timeout for DOCUMENT_ROLE and Budget semantic operations.
AUDIT_MODEL_READ_TIMEOUT_SECONDS=60
AUDIT_MATERIAL_MODEL_READ_TIMEOUT_SECONDS=180
# CONTRACT_TEXT_ANALYSIS provider read timeout; capped again by its remaining cumulative budget.
AUDIT_CONTRACT_MODEL_READ_TIMEOUT_SECONDS=600
# Cumulative provider-call budget for one Contract Semantic operation; not an HTTP wall-clock deadline.
AUDIT_MODEL_TOTAL_BUDGET_SECONDS=900
AUDIT_MODEL_CHUNK_CHARS=6000
AUDIT_MODEL_MAX_CHUNKS=20
# Budget/procurement material extraction and F10 source bounds (not token counts).
AUDIT_MATERIAL_CHUNK_CHARS=3200
AUDIT_MATERIAL_CHUNK_BYTES=8000
AUDIT_MATERIAL_CONTEXT_CHARS=96
AUDIT_MATERIAL_OUTPUT_TOKENS=1536
# Empty: temporary in-memory retry reuse only. Optional private absolute directory
# enables restart reuse; successful operations clear their candidates.
AUDIT_MATERIAL_CHECKPOINT_ROOT=
AUDIT_MATERIAL_CHECKPOINT_TTL_SECONDS=900
# Must exceed the Backend AI HTTP read timeout and includes step finalization margin.
AUDIT_CONTRACT_REVIEW_WORKER_TIMEOUT=PT20M
AUDIT_AUTH_MAX_FAILED_ATTEMPTS=5
AUDIT_AUTH_LOCK_DURATION=15m
AUDIT_CORS_ALLOWED_ORIGINS=
AUDIT_TECH_LOG_LEVEL=INFO
AUDIT_OBSERVABILITY_FLOW_DEBUG_ENABLED=false
AUDIT_FLOW_DEBUG_LOG_LEVEL=INFO
AUDIT_TRACE_SAMPLING_PROBABILITY=1.0
AUDIT_FILE_STORAGE_ROOT=
AUDIT_UPLOAD_MAX_FILE_SIZE=50MB
AUDIT_UPLOAD_MAX_REQUEST_SIZE=52MB
AUDIT_UPLOAD_PENDING_RECOVERY_AGE=15m
AUDIT_UPLOAD_STAGING_RETENTION_AGE=24h
AUDIT_ROLE_ASSESSMENT_RUNNING_RECOVERY_AGE=15m
# Local bootstrap only. Generate the delegating hash with the offline PasswordHashTool; never put a raw password here.
AUDIT_LOCAL_ACCOUNT_ID=
AUDIT_LOCAL_ACCOUNT_USERNAME=
AUDIT_LOCAL_ACCOUNT_PASSWORD_HASH=
AUDIT_LOCAL_ACCOUNT_REAL_NAME=
AUDIT_LOCAL_ACCOUNT_ROLES=SYSTEM_ADMIN
