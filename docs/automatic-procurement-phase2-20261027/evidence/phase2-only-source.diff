+        status["source_manifest_sha256"]=hashlib.sha256(before).hexdigest()
+        status["restore_manifest_sha256"]=hashlib.sha256(after).hexdigest()
+    else:print(verify.stderr.decode("utf-8","replace")[-600:])
+else:status["restore"]="FAILED"
