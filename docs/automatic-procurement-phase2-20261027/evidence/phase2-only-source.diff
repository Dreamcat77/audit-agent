+                        try{Thread.sleep(100);}catch(InterruptedException e){Thread.currentThread().interrupt();throw new IllegalStateException(e);}
+                    }
+                }
+                return AuditCaseIntegrationTest.sourceFixture(segments);
+            };
+        }
+    }
+}
