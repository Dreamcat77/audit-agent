+      {report.offers.map(o => <div key={o.documentId} className="border-t border-slate-100 pt-2"><p className="font-medium">{o.supplier} · {o.amount} 元
+        {' '}· {report.calculation ? report.calculation.quotes.find(q => q.supplierName === o.supplier)?.overBudget ? '超过预算' : '未超过预算' : '超预算检查未执行'}</p>
+        <ul className="text-xs mt-1">{o.lines.map((l, i) => <li key={i}>{l.item}：{l.quantity} × {l.unitPrice} = {l.amount} 元</li>)}</ul>
+        <p className="text-xs text-slate-500">明细核算：{o.lineValidation === 'VERIFIED' ? '一致' : '未完整核实'}</p></div>)}
+      {report.calculation && <p>报价均值 {report.calculation.averageQuote} 元 · 变异系数 {report.calculation.coefficientOfVariation}</p>}
