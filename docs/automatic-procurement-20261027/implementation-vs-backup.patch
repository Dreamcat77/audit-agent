+      request<Case>(`${path}/${current.id}`).then(c => { if (active) { setCurrent(c); setError(''); } })
+        .catch(e => { if (active) setError(userFacingError(e, '进度读取失败，案件与原操作已保留')); });
+    }, 2500);
+    return () => { active = false; window.clearInterval(timer); };
