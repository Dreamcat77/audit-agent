+  if (!enabled) return null;
+  const report = current?.report;
+  return <section className="rounded-lg border border-slate-200 bg-white p-5 space-y-4" aria-label="上传材料自动询比价">
+    <div><h3 className="text-sm font-semibold">上传采购材料，自动生成询比价分析</h3>
+      <p className="text-xs text-slate-500 mt-1">选择同一项目的 PDF、DOCX 材料，无需填写预算、项目编号或供应商。</p></div>
+    <input type="file" multiple accept=".pdf,.docx" disabled={busy || !!current && ['UPLOADING','QUEUED','RUNNING'].includes(current.status)}
+      aria-label="选择采购材料并开始分析" onChange={e => { const selected = Array.from(e.target.files || []); e.target.value = ''; void upload(selected); }} />
+    {busy && <p role="status">正在保存材料…</p>}
+    {error && <p role="alert" className="text-sm text-red-700">{error}</p>}
+    {uncertain && files.length > 0 && <button type="button" disabled={busy} onClick={() => void upload(files)}>重试原上传</button>}
+    {cases.length > 0 && <label className="text-xs">历史案件 <select value={current?.id || ''} onChange={async e => {
+      try { setCurrent(await request<Case>(`${path}/${e.target.value}`)); setEvidence(null); }
+      catch (error) { setError(userFacingError(error, '案件读取失败')); }
+    }}>{cases.map(c => <option key={c.id} value={c.id}>{c.caseNumber}</option>)}</select></label>}
+    {current && <><p className="text-sm" role="status">{labels[current.status] || current.status} · 已提取 {current.documents.filter(d => d.status === 'EXTRACTED').length}/{current.documents.length} 份文件</p>
+      <ul className="text-xs space-y-1">{current.documents.map(d => <li key={d.id}>{d.name} · {labels[d.status] || d.status}
+        {d.errorCode && ' · 该文件尚未完成可靠提取'} <button type="button" className="text-blue-700" onClick={() => void showEvidence(d.id)}>查看证据</button>
+        {' '}<a href={apiUrl(`${path}/${current.id}/files/${d.id}/original`)}>原始文件</a></li>)}</ul></>}
